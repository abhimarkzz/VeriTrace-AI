# VeriTrace AI Backend — Environment Variables
#
# Copy this file to .env and fill in values as services are added.
#
# ─── Application ───
APP_NAME=VeriTrace AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# ─── Server ───
HOST=0.0.0.0
PORT=8000

# ─── CORS ───
# Comma-separated list of allowed origins.
# In development, this should include the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Input Limits ───
MAX_INPUT_LENGTH=10000

# ─── AI / LLM (Phase 3 — not used yet) ───
# LLM_PROVIDER=gemini
# LLM_API_KEY=[REDACTED]
# LLM_MODEL=gemini-2.0-flash

# ─── Web Search (Phase 3 — not used yet) ───
# SEARCH_PROVIDER=serper
# SEARCH_API_KEY=[REDACTED]

# ─── Database ───
# SQLite for local development (default, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./veritrace_dev.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/veritrace

# ─── STEP 6: Evidence Retrieval ───
# Google Fact Check Tools API Key (server-side only, NEVER expose to React frontend)
# Used specifically for factual claim reviews via the claims:search endpoint.
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here
EVIDENCE_PROVIDER=google_factcheck
EVIDENCE_CACHE_TTL_SECONDS=3600
EVIDENCE_TIMEOUT_SECONDS=10.0
EVIDENCE_MAX_RETRIES=2
EVIDENCE_MAX_RESULTS=10
EVIDENCE_ENABLE_OFFLINE_FALLBACK=false

# ─── STEP 7: Evidence Ranking & NLI Verification ───
NLI_MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_BACKEND=deterministic  # "local" | "hosted" | "deterministic"
# NLI_ENDPOINT_URL=https://api-inference.huggingface.co/models/...
# NLI_API_KEY=[REDACTED]
NLI_ENTAILMENT_THRESHOLD=0.65
NLI_CONTRADICTION_THRESHOLD=0.65
NLI_NEUTRAL_THRESHOLD=0.50
EVIDENCE_MIN_RELEVANCE_THRESHOLD=0.30
EVIDENCE_TOP_K=5
RANKING_WEIGHT_SIMILARITY=0.50
RANKING_WEIGHT_ENTITY=0.35
RANKING_WEIGHT_RECENCY=0.15

# ─── STEP 8: Decision Fusion, Calibration & Uncertainty ───
# Temperature scaling parameter (T > 1.0 softens overconfident neural network predictions)
CALIBRATION_TEMPERATURE=1.25
# Optional custom path for model calibration metadata registry
# CALIBRATION_DATA_PATH=app/ml/calibration_data.json
# Qualitative confidence thresholds for uncertainty communication
CONFIDENCE_THRESHOLD_HIGH=0.75
CONFIDENCE_THRESHOLD_MODERATE=0.50
# Penalty multiplier applied when contradictory evidence is retrieved
CONFLICT_PENALTY_WEIGHT=0.35
# Minimum independent source domains required to elevate evidence strength to STRONG
DECISION_MIN_INDEPENDENT_SOURCES_FOR_STRONG=2

# ─── STEP 10: Security, Privacy & Observability ───
# Request Rate Limiting (per IP sliding window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Data Privacy & Retention
# By default, raw input text is not permanently persisted to protect user privacy (SHA256 fingerprint stored).
PERSIST_USER_INPUT_TEXT=false
# Retention window in days (records older than this can be purged)
DATA_RETENTION_DAYS=7

# Server Logging Format ("standard" for human-readable terminal logs, "json" for Cloud Logging)
LOG_FORMAT=standard


