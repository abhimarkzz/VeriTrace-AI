# ==============================================================================
# VeriTrace AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# ── Database Configuration ───────────────────────────────────────────────────
# For Host Development & CLI Migrations (connecting to PostgreSQL container):
DATABASE_URL=postgresql+asyncpg://veritrace:veritrace_secret@localhost:5432/veritrace
# For Local Development (SQLite fallback):
# DATABASE_URL=sqlite+aiosqlite:///./veritrace_dev.db

# Host port mapping for PostgreSQL (change to 5433 if host 5432 is already bound):
POSTGRES_PORT=5432

# ── Third-Party Fact Check API ────────────────────────────────────────────────
# Get an API key from: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
# If omitted or left empty, VeriTrace operates in offline mode using verified local fixtures.
GOOGLE_FACTCHECK_API_KEY=

# ── Machine Learning & NLP Model Configuration ───────────────────────────────
# Base multilingual model direction: XLM-RoBERTa
MODEL_NAME=FacebookAI/xlm-roberta-base
# Execution device: 'cpu', 'cuda', 'mps', or 'auto'
MODEL_DEVICE=auto
# Max token sequence length for truncation/padding
MODEL_MAX_LENGTH=256
# Load heavy sequence classifier into memory on startup (false for fast boot)
MODEL_LOAD_ON_STARTUP=false
# Model execution backend: 'local', 'hosted', or 'mock'
MODEL_BACKEND=local
# Optional hosted endpoint URL and bearer token (if using hosted inference)
# MODEL_ENDPOINT_URL=https://api-inference.huggingface.co/models/...
# MODEL_API_KEY=your_hf_token_here

# ── Frontend API Configuration ────────────────────────────────────────────────
# Base URL for the FastAPI backend. In Docker with Nginx reverse proxy, leave empty or set http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ── Application Logging & Observability ──────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log formatting: 'standard' or 'json' (structured for cloud observability)
LOG_FORMAT=standard

# ── CORS Origins ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,http://127.0.0.1:5173

# ── Security & Privacy Controls ──────────────────────────────────────────────
# In-memory sliding-window rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Privacy compliance: Redact plaintext user message to SHA-256 in DB by default
PERSIST_USER_INPUT_TEXT=false
# Data retention window in days before automated cleanup
DATA_RETENTION_DAYS=7
